# --- Runtime state that must NOT travel (big, or regenerated on the cluster) ---
# NOTE: git has no trailing comments in this file. A comment must be on its own line,
# or it becomes part of the pattern and the rule silently stops matching.

# per-template simulator fits (hundreds of MB)
cache/
benchmarks/cache/
hpc/smoke_cache/
# SLURM stdout/stderr
logs/
# generated task lists
hpc/tasks/
hpc/tasks_pilot/
benchmarks/results_test/

# downloaded templates; SHA256SUMS is the record that travels instead
benchmarks/data/*
!benchmarks/data/SHA256SUMS

# Per-cell benchmark output is far too large to track. The summary tables ARE the
# deliverable and do travel back from the cluster (protocol section 12).
results/*
!results/summary/
# ...except the long table: ~90 MB per run and it changes every time, so committing it makes the
# repo grow by that much per cycle (GitHub warns over 50 MB, refuses over 100). collect_report.sh
# already writes report/summary/metrics_long.csv.gz, which is the copy that travels.
results/summary/metrics_long.csv

# --- Verification record: these DO travel back from the cluster (protocol section 13) ---
# hpc/installed_packages.csv, hpc/install_log.txt, hpc/prep_caches.csv,
# hpc/smoke_*.csv and hpc/smoke_errors.log are tracked on purpose. Do not ignore them.

# --- R ---
*.tar.gz
.Rhistory
.RData
.Rproj.user/
