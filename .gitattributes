# Normalise line endings.
#
# The repository stores every text file with LF, and checks it out with LF on
# every platform. This repo is edited on Windows and run on Linux (HPC), so a
# single ending everywhere avoids spurious whole-file diffs and keeps shell
# and SLURM scripts executable on the cluster.
* text=auto eol=lf

# Explicit types (documented rather than left to detection).
*.R      text eol=lf
*.r      text eol=lf
*.Rd     text eol=lf
*.md     text eol=lf
*.csv    text eol=lf
DESCRIPTION text eol=lf
NAMESPACE   text eol=lf

# Binary payloads, should they ever appear.
*.rds    binary
*.RData  binary
*.rda    binary
*.png    binary
*.pdf    binary
